{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue view:*)",
      "Bash(cmake:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(where:*)",
      "Bash(findstr:*)",
      "Bash(assoc:*)",
      "Bash(ftype:*)",
      "Bash(echo:*)",
      "Bash(timeout:*)",
      "Bash(tasklist:*)",
      "Bash(taskkill /im TripSitter.exe:*)",
      "Bash(taskkill /im ffmpeg.exe:*)",
      "Bash(taskkill /im test_backend_api.exe:*)",
      "Bash(taskkill /im cmake.exe:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(cmd /c dir:*)",
      "Bash(cmd /c echo:*)",
      "Bash(reg query:*)",
      "Bash(powershell -Command Get-ChildItem:*)",
      "Bash(powershell -Command Test-Path:*)",
      "Bash(powershell -Command Copy-Item:*)",
      "Bash(powershell -Command Get-Process:*)",
      "Bash(powershell -Command Stop-Process -Name TripSitter)",
      "Bash(powershell -Command Stop-Process -Name ffmpeg)",
      "Bash(powershell -Command Stop-Process -Name test_backend_api)",
      "Bash(powershell -Command Stop-Process -Name cmake)",
      "Bash(powershell -File scripts/add-wallpaper.ps1)",
      "Bash(powershell -File scripts/build_release.ps1)",
      "Bash(powershell -File scripts/check_gpu_runner.ps1)",
      "Bash(powershell -File scripts/check_no_ffmpeg.ps1)",
      "Bash(powershell -File scripts/check-ffmpeg-nvenc.ps1)",
      "Bash(powershell -File scripts/deploy_tripsitter.ps1)",
      "Bash(powershell -File scripts/run_tracing_local.ps1)",
      "Bash(powershell -ExecutionPolicy Bypass -File scripts/check_gpu_runner.ps1)",
      "Bash(powershell -ExecutionPolicy Bypass -File scripts/deploy_tripsitter.ps1)",
      "Bash(./build/tests/Release/test_backend_api.exe:*)",
      "Bash(./build/tests/Release/test_spectral_flux.exe:*)",
      "Bash(makensis:*)",
      "Bash(cpack:*)",
      "WebFetch(domain:forums.unrealengine.com)",
      "WebFetch(domain:dev.epicgames.com)"
    ]
  },
  "_comment": "Copy this file to settings.local.json and customize paths below for your machine",
  "_machine_specific_permissions": {
    "_description": "Add these to the 'allow' array above, replacing paths with your local UE5 installation",
    "ue5_build": "Bash(<YOUR_UE5_PATH>/Engine/Build/BatchFiles/Build.bat:*)",
    "desktop_check": "Bash(powershell -Command \"Get-ChildItem -Path \\\"$env:USERPROFILE\\\\Desktop\\\\TripSitterBuild\\\\Windows\\\" -ErrorAction SilentlyContinue | Select-Object Name, Length\")"
  }
}
