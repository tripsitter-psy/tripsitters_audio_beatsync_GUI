# Build environment for the portable Linux backend.
#
# Ubuntu 22.04 pins the glibc requirement of libbeatsync_backend_shared.so to
# 2.35 and libstdc++ to GCC 11, so the resulting library runs on Ubuntu 22.04+,
# Debian 12+, Fedora 36+, openSUSE Leap 15.5+ and inside the freedesktop 25.08
# Flatpak runtime. Everything else in the bundle (Unreal binary, FFmpeg, ONNX
# Runtime) already targets glibc <= 2.28.
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config git patchelf \
        xz-utils ca-certificates curl file \
        libsamplerate0-dev squashfs-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
